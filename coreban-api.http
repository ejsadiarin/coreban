# coreban-api — call through the gateway ({{host}} = gateway). Direct calls
# to :6972 need a gateway-minted internal token with audience `coreban`.
@host = http://localhost:8080

### Liveness (direct, no token)

GET http://localhost:6972/health

### Verified health through the gateway (session or coreban:read key)
# 200 {"status":"ok","owner":"<your user id>"} proves token + database.

GET {{host}}/api/coreban/health

### Admin targeted read: owner resolves to the target user

GET {{host}}/api/coreban/health?user_id=PASTE_TARGET_USER_UUID_HERE

### Direct without a token (expect 401)

GET http://localhost:6972/api/coreban/health

# ─── Boards ────────────────────────────────────────────────────────────────
# Reads honour an admin's targeted read (?user_id= at the gateway); writes
# always bind to the caller. Another owner's board answers 404.

### List my boards (oldest first, no columns)

GET {{host}}/api/coreban/boards

### Create a board (starts with Todo, Doing, Done columns) → 201

POST {{host}}/api/coreban/boards
Content-Type: application/json

{
  "name": "Homelab"
}

### Get a board with its columns in order

GET {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE

### Rename a board

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE
Content-Type: application/json

{
  "name": "Homelab ops"
}

### Delete a board and everything on it → 204

DELETE {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE

# ─── Columns ───────────────────────────────────────────────────────────────
# Every board keeps at least one column per status (todo, in_progress, done),
# and a column holding any card can't be deleted: both refusals are 409 with
# the reason in "error".

### Add a column at the end → 201

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/columns
Content-Type: application/json

{
  "name": "Review",
  "status": "in_progress"
}

### Rename a column and/or change its status (its cards follow)

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/columns/PASTE_COLUMN_UUID_HERE
Content-Type: application/json

{
  "name": "Shipped",
  "status": "done"
}

### Move a column to a slot among the others (0 = leftmost)

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/columns/PASTE_COLUMN_UUID_HERE/move
Content-Type: application/json

{
  "index": 0
}

### Delete an empty column → 204

DELETE {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/columns/PASTE_COLUMN_UUID_HERE

# ─── Cards ─────────────────────────────────────────────────────────────────
# A card's status is its column's (ADR-0001). GET /boards/{id} lists each
# column's cards in priority order.

### Create a card at the bottom of a column → 201

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards
Content-Type: application/json

{
  "column_id": "PASTE_COLUMN_UUID_HERE",
  "title": "Upgrade k3s"
}

### Get a card (status reported from its column)

GET {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE

### Edit a card's title and/or markdown description (absent fields unchanged)

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE
Content-Type: application/json

{
  "title": "Upgrade k3s to 1.31",
  "description": "Drain nodes first:\n\n```sh\nkubectl drain node1 --ignore-daemonsets\n```"
}

### Move a card: to a column, at a slot among that column's other cards
# index 0 is the top; anything past the end lands last.

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE/move
Content-Type: application/json

{
  "column_id": "PASTE_COLUMN_UUID_HERE",
  "index": 0
}

### Set a card's due: a date, or a date and time (no offset: your timezone)

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE
Content-Type: application/json

{
  "due": { "date": "2026-11-14" }
}

### Clear the due, or archive (true) / restore (false) the card

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE
Content-Type: application/json

{
  "due": null,
  "archived": true
}

### List a board's archived cards, most recently archived first

GET {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards?archived=true

### Delete a card for good (archived or not) → 204

DELETE {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE

# ─── Labels ────────────────────────────────────────────────────────────────
# Labels belong to one board; names are unique on it, ignoring case (409).
# Cards list their labels by name in "labels".

### List a board's labels

GET {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/labels

### Add a label → 201

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/labels
Content-Type: application/json

{
  "name": "k8s"
}

### Rename a label

PATCH {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/labels/PASTE_LABEL_UUID_HERE
Content-Type: application/json

{
  "name": "Kubernetes"
}

### Apply a label to a card → 204 (DELETE the same path removes it)

PUT {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards/PASTE_CARD_UUID_HERE/labels/PASTE_LABEL_UUID_HERE

### Delete a label, taking it off its cards → 204

DELETE {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/labels/PASTE_LABEL_UUID_HERE

# ─── Settings ──────────────────────────────────────────────────────────────
# The owner's notification target (an ntfy topic name under coreban-, never
# a URL) and IANA timezone. Defaults: no topic, UTC.

### Get my settings ("saved": false means these are the defaults, nothing chosen yet)

GET {{host}}/api/coreban/settings

### Save my settings (ntfy_topic null or "" clears the target)
# 400 for a URL, a missing coreban- prefix, or an unknown timezone;
# 409 when another owner already uses the topic.

PUT {{host}}/api/coreban/settings
Content-Type: application/json

{
  "ntfy_topic": "coreban-ejs-phone",
  "timezone": "Asia/Manila"
}

# ─── Reminders ─────────────────────────────────────────────────────────────
# Times come back in your timezone (Settings). Nothing is sent while you have
# no notification target: each pending reminder says
# "paused": "no_notification_target".

### List my reminders, soonest first, with next_fire_at and last_delivery

GET {{host}}/api/coreban/reminders

### Create a one-off → 201 (no offset: read in your timezone)

POST {{host}}/api/coreban/reminders
Content-Type: application/json

{
  "message": "Renew the cert",
  "schedule": { "kind": "once", "at": "2026-12-01T09:00" }
}

### Create a recurring reminder: daily, weekly on chosen days, or every N days

POST {{host}}/api/coreban/reminders
Content-Type: application/json

{
  "message": "CKA drills",
  "schedule": { "kind": "weekly", "weekdays": ["MO", "WE", "FR"], "time": "19:30" }
}

### Every 3 days at 08:00, counting from a date (defaults to today)

POST {{host}}/api/coreban/reminders
Content-Type: application/json

{
  "message": "Shell drills: ps | awk",
  "schedule": { "kind": "every", "days": 3, "from": "2026-11-10", "time": "08:00" }
}

### Remind me at a card's due (09:00 on a date-only due) → 201

POST {{host}}/api/coreban/reminders
Content-Type: application/json

{
  "card_id": "PASTE_CARD_UUID_HERE",
  "schedule": { "kind": "due" }
}

### A card's reminders

GET {{host}}/api/coreban/reminders?card_id=PASTE_CARD_UUID_HERE

### Edit the message and/or reschedule (a new schedule re-arms it);
### "card_id": null detaches it from its card

PATCH {{host}}/api/coreban/reminders/PASTE_REMINDER_UUID_HERE
Content-Type: application/json

{
  "schedule": { "kind": "once", "at": "2026-12-01T10:30:00+08:00" }
}

### Delete a reminder → 204

DELETE {{host}}/api/coreban/reminders/PASTE_REMINDER_UUID_HERE

# ─── Feed ──────────────────────────────────────────────────────────────────
# Notes come back oldest first. "older" is the cursor for the page before;
# it is null once a page reaches the first note. A linked note has empty
# "text" and a "link": {"kind": "reminder"|"card", "deleted": bool,
# "reminder": {…} | "card": {id, board_id, board_name, column_name, status,
# title, archived_at}}, live, or its last state once deleted.

### The newest page of my Feed (default 50 notes, at most 200)

GET {{host}}/api/coreban/notes

### The page before it

GET {{host}}/api/coreban/notes?before=PASTE_OLDER_CURSOR_HERE&limit=50

### Post a note → 201 (blank or over 4000 characters → 400)

POST {{host}}/api/coreban/notes
Content-Type: application/json

{ "text": "read later https://example.com/article" }

### Edit a note's text (an archived note → 409; restore it first)

PATCH {{host}}/api/coreban/notes/PASTE_NOTE_UUID_HERE
Content-Type: application/json

{ "text": "read this weekend https://example.com/article" }

### Archive (true) or restore (false)

PATCH {{host}}/api/coreban/notes/PASTE_NOTE_UUID_HERE
Content-Type: application/json

{ "archived": true }

### Permanently delete a note → 204

DELETE {{host}}/api/coreban/notes/PASTE_NOTE_UUID_HERE

### Capture a reminder from the Feed: it gets a linked note at the end

POST {{host}}/api/coreban/reminders
Content-Type: application/json

{
  "message": "call dentist",
  "schedule": { "kind": "once", "at": "2026-12-01T07:00" },
  "note": "new"
}

### Make a card from a plain note: the note links it in place

POST {{host}}/api/coreban/boards/PASTE_BOARD_UUID_HERE/cards
Content-Type: application/json

{ "column_id": "PASTE_COLUMN_UUID_HERE", "title": "fix NAS backup", "note": "PASTE_NOTE_UUID_HERE" }
