PORT=6972

# Runtime: pooler host, DML-only coreban_role. No search_path param needed —
# the role's search_path is coreban (internal/db/bootstrap.sql).
DATABASE_URL=postgresql://coreban_role:pass@<pooler-host>/coredb?sslmode=require
# Migrations (`make migrate-up` / `coreban-api migrate`): direct host, owner
# role, scoped to the coreban schema by the options form.
MIGRATION_URL=postgresql://neondb_owner:pass@<direct-host>/coredb?sslmode=require&channel_binding=require&options=-c%20search_path%3Dcoreban

# Gateway internal token. JWT_AUDIENCE is coreban's own name — never the
# gateway's comma-separated list. Boot fails if the JWKS is unreachable.
JWT_ISSUER=https://gateway.internal
JWT_AUDIENCE=coreban
# Native run against a native gateway: http://localhost:18080/.well-known/jwks.json
# (compose overrides this to http://coregateway-api:8080/.well-known/jwks.json)
JWT_JWKS_URL=https://gateway.internal/.well-known/jwks.json

# Reminder delivery: your ntfy server and coreban's write token (granted
# only on coreban-* topics, anonymous access denied; see README "ntfy server").
# Leave NTFY_URL empty to run without sending; set it and the token is required.
NTFY_URL=
NTFY_TOKEN=

# Most reminders one owner may have (default 100).
REMINDER_CAP=100
